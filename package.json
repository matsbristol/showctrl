{
  "name": "showctrl",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "dev:worker": "vite build && wrangler dev",
    "deploy": "vite build && wrangler deploy",
    "db:init:local": "wrangler d1 execute showctrl --local --file worker/schema.sql",
    "db:init": "wrangler d1 execute showctrl --remote --file worker/schema.sql",
    "check:orgs": "node scripts/check-orgs.mjs",
    "db:migrate:orgs": "wrangler d1 execute showctrl --remote --file worker/migrations/0002_orgs.sql",
    "db:migrate:orgs:local": "wrangler d1 execute showctrl --local --file worker/migrations/0002_orgs.sql",
    "typecheck:worker": "tsc -p worker/tsconfig.json",
    "simulate": "node scripts/simulate.mjs"
  },
  "dependencies": {
    "jose": "^6.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261018.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "happy-dom": "^21.0.3",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  }
}
