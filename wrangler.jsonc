{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "showctrl",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },

  // The public address. The zone is on Cloudflare; Access must list this hostname too.
  "routes": [{ "pattern": "showctrl.no", "custom_domain": true }],
  "workers_dev": false,
  // Per-version preview URLs would sit outside the Access application, so they stay off.
  "preview_urls": false,

  // The Vite build. The Worker runs first only for the API and server time;
  // every other path is the app, with index.html as the single-page fallback.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/time"]
  },

  "durable_objects": {
    "bindings": [{ "name": "EVENT", "class_name": "EventObject" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["EventObject"] }],

  // Sends sign-in codes. showctrl.no is enabled for sending (npx wrangler email sending enable showctrl.no).
  "send_email": [{ "name": "EMAIL" }],

  // Uploaded documents and nightly backups, both EU-only. Off until R2 is enabled on the account
  // (dashboard → R2), then:
  //   npx wrangler r2 bucket create showctrl-files --jurisdiction eu
  //   npx wrangler r2 bucket create showctrl-backups --jurisdiction eu
  // and uncomment. Without them, uploads are refused (links still work) and the nightly run only logs.
  // "r2_buckets": [
  //   { "binding": "FILES", "bucket_name": "showctrl-files", "jurisdiction": "eu" },
  //   { "binding": "BACKUPS", "bucket_name": "showctrl-backups", "jurisdiction": "eu" }
  // ],

  // The nightly backup, at 02:00 UTC (03:00 or 04:00 in Oslo).
  "triggers": { "crons": ["0 2 * * *"] },

  // Create with: npx wrangler d1 create showctrl — then paste the id here.
  "d1_databases": [
    { "binding": "DB", "database_name": "showctrl-eu", "database_id": "188dc3be-d693-4131-a297-01b1e9f81676" }
  ],

  // Optional: ACCESS_TEAM_DOMAIN and ACCESS_AUD accept Cloudflare Access tokens too (see DEPLOY.md).
  // Left out, so only showctrl's own sign-in counts and Log out always signs out.
  // SUPERADMINS: who runs showctrl itself and adds organisations (comma-separated emails).
  "vars": {
    "SUPERADMINS": "mats@larkolluka.no,mats.bristol@gmail.com",
    // Events are stored and processed only in Cloudflare's EU jurisdiction (see worker/events.ts).
    "EVENT_JURISDICTION": "eu"
  }
}
