{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "showctrl",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },

  // The public address. The zone is on Cloudflare; Access must list this hostname too.
  "routes": [{ "pattern": "showctrl.no", "custom_domain": true }],
  "workers_dev": false,
  // Per-version preview URLs would sit outside the Access application, so they stay off.
  "preview_urls": false,

  // The Vite build. The Worker runs first only for the API and server time;
  // every other path is the app, with index.html as the single-page fallback.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/time"]
  },

  "durable_objects": {
    "bindings": [{ "name": "EVENT", "class_name": "EventObject" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["EventObject"] }],

  // Uploaded documents. Off until R2 is enabled on the account (dashboard → R2), then:
  //   npx wrangler r2 bucket create showctrl-files
  // and uncomment. Without it, uploads are refused and document links still work.
  // "r2_buckets": [{ "binding": "FILES", "bucket_name": "showctrl-files" }],

  // Create with: npx wrangler d1 create showctrl — then paste the id here.
  "d1_databases": [
    { "binding": "DB", "database_name": "showctrl", "database_id": "bf83e827-ec54-43c9-aef1-545cc7d3aa14" }
  ],

  // Set ACCESS_TEAM_DOMAIN and ACCESS_AUD for production (see DEPLOY.md).
  // CREATORS: who may create events (comma-separated emails, or *).
  "vars": {
    "CREATORS": "mats@larkolluka.no",
    "ACCESS_TEAM_DOMAIN": "https://nsgsystems.cloudflareaccess.com",
    "ACCESS_AUD": "11fb4e35fe67f335ac59707c92e4075f6a97774c9d26f23916a58b4ab925f095"
  }
}
